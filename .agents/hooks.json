{
  "precommit-sh-check": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash harness/guards/precommit-sh-check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "syntax-check": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && SH_CHECK_SEVERITY=error bash templates/hooks/common/sh-check.sh"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash templates/hooks/python/py-check.sh"
          }
        ]
      }
    ]
  },
  "harness-verify": {
    "Stop": [
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel)\" && bash harness/guards/stop-verify.sh",
        "timeout": 900
      }
    ]
  }
}
