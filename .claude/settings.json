{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Edit(//Users/**/AGENTS.override.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/precommit-sh-check.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "SH_CHECK_SEVERITY=error bash \"$CLAUDE_PROJECT_DIR/templates/hooks/common/sh-check.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/templates/hooks/python/py-check.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/registry-guard.sh\"",
            "statusMessage": "validating registry.txt…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/types-guard.sh\"",
            "statusMessage": "type checking…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests-guard.sh\"",
            "statusMessage": "running test suite…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-paths-guard.sh\"",
            "statusMessage": "checking skill paths…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-compat-guard.sh\"",
            "statusMessage": "checking bash 3.2 compatibility…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/credential-backend-guard.sh\"",
            "statusMessage": "checking credential backends…"
          },
          {
            "type": "command",
            "command": "SECRET_SCAN_SCOPE=tree OSV_SCOPE=recursive bash \"$CLAUDE_PROJECT_DIR/templates/hooks/common/secret-scan.sh\"",
            "statusMessage": "secret scan…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/state-layer-guard.sh\"",
            "statusMessage": "checking state layer…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/runtime-drift-guard.sh\"",
            "statusMessage": "checking runtime drift…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-evidence.sh\"",
            "statusMessage": "checking commit evidence…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/registry-guard.sh\"",
            "statusMessage": "validating registry.txt…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/types-guard.sh\"",
            "statusMessage": "type checking…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests-guard.sh\"",
            "statusMessage": "running test suite…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-paths-guard.sh\"",
            "statusMessage": "checking skill paths…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-compat-guard.sh\"",
            "statusMessage": "checking bash 3.2 compatibility…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/credential-backend-guard.sh\"",
            "statusMessage": "checking credential backends…"
          },
          {
            "type": "command",
            "command": "SECRET_SCAN_SCOPE=tree OSV_SCOPE=recursive bash \"$CLAUDE_PROJECT_DIR/templates/hooks/common/secret-scan.sh\"",
            "statusMessage": "secret scan…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/state-layer-guard.sh\"",
            "statusMessage": "checking state layer…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/runtime-drift-guard.sh\"",
            "statusMessage": "checking runtime drift…"
          }
        ]
      }
    ]
  }
}
