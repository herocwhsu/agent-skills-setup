{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_shell_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash harness/guards/precommit-sh-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|file_edit|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && SH_CHECK_SEVERITY=error bash templates/hooks/common/agent-hook.sh codex edit templates/hooks/common/sh-check.sh"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash templates/hooks/common/agent-hook.sh codex edit templates/hooks/python/py-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash harness/guards/stop-verify.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash harness/guards/stop-verify.sh"
          }
        ]
      }
    ]
  }
}
