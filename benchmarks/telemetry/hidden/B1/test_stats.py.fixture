import pytest

from stats import mean, median


def test_mean_of_three():
    assert mean([1, 2, 3]) == 2


def test_mean_of_empty_list_raises():
    with pytest.raises(ValueError):
        mean([])


def test_median_odd():
    assert median([3, 1, 2]) == 2


def test_median_even():
    assert median([4, 1, 3, 2]) == 2.5


def test_mean_of_four():
    assert mean([2, 4, 6, 8]) == 5


def test_mean_of_one():
    assert mean([10]) == 10


def test_mean_with_negatives():
    assert mean([-3, 3, 6]) == 2
