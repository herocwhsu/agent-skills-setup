# Copy to ~/.env.kiro-gateway (chmod 600). Rendered automatically by
# `kiro-gateway init` from the keychain entry agent-skills-setup:kiro-gateway.
# Values are UNQUOTED: docker --env-file reads the whole post-`=` line verbatim
# and does NOT strip quotes, so quoting a value embeds literal quote chars in
# the container env. Spaces (e.g. in the DB path) are preserved unquoted.
PROXY_API_KEY=replace-with-your-proxy-key
KIRO_CLI_DB_FILE=/Users/you/Library/Application Support/kiro-cli/data.sqlite3
# High-effort/large-prompt calls (e.g. Claude Code subagents) can take >15s to
# first token; the gateway's default FIRST_TOKEN_TIMEOUT=15 would 500 them.
# Must stay below STREAMING_READ_TIMEOUT.
FIRST_TOKEN_TIMEOUT=240
STREAMING_READ_TIMEOUT=600
# The kiro-cli data dir is bind-mounted read-only, so the gateway's post-refresh
# credential write-back to that SQLite DB can never succeed. Enabling this skips
# the attempt, along with the misleading "no matching keys found" WARNING pair it
# logs on every refresh. Upstream default: false.
SQLITE_READONLY=true
# The gateway injects a <thinking_mode> block into every request by default.
# Since 2026-10-05 Kiro answers it with a REASONING_EXTRACTION refusal, which the
# gateway passes on as an empty 200 reply, so this must stay false. Upstream
# default: enabled.
FAKE_REASONING=false
